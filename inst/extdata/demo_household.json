{
  "Id": "d0000000000000000000000000000001",
  "Title": "Demo Household Survey",
  "VariableName": "demo_hh",
  "Macros": {
    "m1": { "Name": "isAdult", "Content": "age >= 15", "Description": "" }
  },
  "Children": [
    {
      "$type": "Group", "PublicKey": "a0000000000000000000000000000001", "Title": "Cover", "VariableName": "cover",
      "IsRoster": false, "ConditionExpression": "",
      "Children": [
        { "$type": "SingleQuestion", "PublicKey": "b0000000000000000000000000000001", "QuestionType": 0,
          "VariableName": "region", "QuestionText": "Region", "Featured": true, "QuestionScope": 0,
          "Answers": [ {"AnswerText": "North", "AnswerValue": "1"}, {"AnswerText": "Central", "AnswerValue": "2"},
                       {"AnswerText": "South", "AnswerValue": "3"} ] },
        { "$type": "SingleQuestion", "PublicKey": "b0000000000000000000000000000002", "QuestionType": 0,
          "VariableName": "district", "QuestionText": "District", "Featured": true,
          "CascadeFromQuestionId": "b0000000000000000000000000000001",
          "Answers": [ {"AnswerText": "North A", "AnswerValue": "11", "ParentValue": "1"},
                       {"AnswerText": "North B", "AnswerValue": "12", "ParentValue": "1"},
                       {"AnswerText": "Central A", "AnswerValue": "21", "ParentValue": "2"},
                       {"AnswerText": "Central B", "AnswerValue": "22", "ParentValue": "2"},
                       {"AnswerText": "South A", "AnswerValue": "31", "ParentValue": "3"},
                       {"AnswerText": "South B", "AnswerValue": "32", "ParentValue": "3"} ] },
        { "$type": "NumericQuestion", "PublicKey": "b0000000000000000000000000000003", "QuestionType": 4,
          "VariableName": "ea_id", "QuestionText": "Enumeration area", "Featured": true, "IsInteger": true },
        { "$type": "NumericQuestion", "PublicKey": "b0000000000000000000000000000004", "QuestionType": 4,
          "VariableName": "hh_id", "QuestionText": "Household number", "Featured": true, "IsInteger": true },
        { "$type": "DateTimeQuestion", "PublicKey": "b0000000000000000000000000000005", "QuestionType": 5,
          "VariableName": "start_time", "QuestionText": "Start time", "IsTimestamp": true },
        { "$type": "SingleQuestion", "PublicKey": "b0000000000000000000000000000006", "QuestionType": 0,
          "VariableName": "consent", "QuestionText": "Does the household agree to the interview?",
          "Answers": [ {"AnswerText": "Yes", "AnswerValue": "1"}, {"AnswerText": "No", "AnswerValue": "2"} ] },
        { "$type": "TextQuestion", "PublicKey": "b0000000000000000000000000000007", "QuestionType": 7,
          "VariableName": "refusal_reason", "QuestionText": "Reason for refusal", "ConditionExpression": "consent == 2" },
        { "$type": "GpsCoordinateQuestion", "PublicKey": "b0000000000000000000000000000008", "QuestionType": 6,
          "VariableName": "hh_gps", "QuestionText": "Dwelling location", "ConditionExpression": "consent == 1" }
      ]
    },
    {
      "$type": "Group", "PublicKey": "a0000000000000000000000000000002", "Title": "Household", "VariableName": "",
      "IsRoster": false, "ConditionExpression": "consent == 1",
      "Children": [
        { "$type": "NumericQuestion", "PublicKey": "c0000000000000000000000000000001", "QuestionType": 4,
          "VariableName": "hhsize", "QuestionText": "How many people live in this household?", "IsInteger": true,
          "ValidationConditions": [ {"Expression": "self.InRange(1, 15)", "Message": "1-15", "Severity": 0} ] },
        { "$type": "Group", "PublicKey": "c0000000000000000000000000000002", "Title": "Members", "VariableName": "members",
          "IsRoster": true, "RosterSizeSource": 0, "RosterSizeQuestionId": "c0000000000000000000000000000001",
          "ConditionExpression": "",
          "Children": [
            { "$type": "TextQuestion", "PublicKey": "c1000000000000000000000000000001", "QuestionType": 7,
              "VariableName": "name", "QuestionText": "Name of member" },
            { "$type": "SingleQuestion", "PublicKey": "c1000000000000000000000000000002", "QuestionType": 0,
              "VariableName": "sex", "QuestionText": "Sex of %name%",
              "Answers": [ {"AnswerText": "Male", "AnswerValue": "1"}, {"AnswerText": "Female", "AnswerValue": "2"} ] },
            { "$type": "NumericQuestion", "PublicKey": "c1000000000000000000000000000003", "QuestionType": 4,
              "VariableName": "age", "QuestionText": "Age in completed years", "IsInteger": true,
              "ValidationConditions": [ {"Expression": "self.InRange(0, 100)", "Message": "0-100", "Severity": 0} ] },
            { "$type": "SingleQuestion", "PublicKey": "c1000000000000000000000000000004", "QuestionType": 0,
              "VariableName": "relation", "QuestionText": "Relationship to head",
              "Answers": [ {"AnswerText": "Head", "AnswerValue": "1"}, {"AnswerText": "Spouse", "AnswerValue": "2"},
                           {"AnswerText": "Child", "AnswerValue": "3"}, {"AnswerText": "Other", "AnswerValue": "4"} ],
              "ValidationConditions": [ {"Expression": "(@rowcode == 1) == (relation == 1)", "Message": "Member 1 must be the head", "Severity": 0} ] },
            { "$type": "SingleQuestion", "PublicKey": "c1000000000000000000000000000005", "QuestionType": 0,
              "VariableName": "school", "QuestionText": "Currently attending school?",
              "ConditionExpression": "age >= 5 && age <= 24",
              "Answers": [ {"AnswerText": "Yes", "AnswerValue": "1"}, {"AnswerText": "No", "AnswerValue": "2"} ] },
            { "$type": "NumericQuestion", "PublicKey": "c1000000000000000000000000000006", "QuestionType": 4,
              "VariableName": "grade", "QuestionText": "Current grade", "IsInteger": true,
              "ConditionExpression": "school == 1",
              "ValidationConditions": [ {"Expression": "self.InRange(1, 13) && self <= age - 4", "Message": "Grade too high for age", "Severity": 0} ] },
            { "$type": "MultyOptionsQuestion", "PublicKey": "c1000000000000000000000000000007", "QuestionType": 3,
              "VariableName": "work", "QuestionText": "Activities in the last 7 days", "ConditionExpression": "$isAdult",
              "Answers": [ {"AnswerText": "Farming", "AnswerValue": "1"}, {"AnswerText": "Wage work", "AnswerValue": "2"},
                           {"AnswerText": "Own business", "AnswerValue": "3"}, {"AnswerText": "Other", "AnswerValue": "-98"} ] },
            { "$type": "TextQuestion", "PublicKey": "c1000000000000000000000000000008", "QuestionType": 7,
              "VariableName": "work_oth", "QuestionText": "Specify other activity", "ConditionExpression": "work.Contains(-98)" },
            { "$type": "Group", "PublicKey": "c1000000000000000000000000000009", "Title": "Jobs", "VariableName": "jobs",
              "IsRoster": true, "RosterSizeSource": 0, "RosterSizeQuestionId": "c1000000000000000000000000000007",
              "Children": [
                { "$type": "NumericQuestion", "PublicKey": "c2000000000000000000000000000001", "QuestionType": 4,
                  "VariableName": "job_hours", "QuestionText": "Hours worked", "IsInteger": true,
                  "ValidationConditions": [ {"Expression": "self.InRange(1, 80)", "Message": "1-80", "Severity": 0} ] },
                { "$type": "NumericQuestion", "PublicKey": "c2000000000000000000000000000002", "QuestionType": 4,
                  "VariableName": "job_wage", "QuestionText": "Weekly wage", "IsInteger": false, "CountOfDecimalPlaces": 2,
                  "ConditionExpression": "@rowcode == 2" }
              ] }
          ] },
        { "$type": "Variable", "PublicKey": "c0000000000000000000000000000003", "Name": "n_adults",
          "Expression": "members.Count(x => x.age >= 18)", "Type": 1, "Label": "Number of adults" },
        { "$type": "SingleQuestion", "PublicKey": "c0000000000000000000000000000004", "QuestionType": 0,
          "VariableName": "respondent", "QuestionText": "Who is answering?", "ConditionExpression": "hhsize > 1",
          "LinkedToQuestionId": "c1000000000000000000000000000001" },
        { "$type": "SingleQuestion", "PublicKey": "c0000000000000000000000000000005", "QuestionType": 0,
          "VariableName": "couple", "QuestionText": "Is there a couple in the household?",
          "ConditionExpression": "n_adults >= 2",
          "Answers": [ {"AnswerText": "Yes", "AnswerValue": "1"}, {"AnswerText": "No", "AnswerValue": "2"} ] }
      ]
    },
    {
      "$type": "Group", "PublicKey": "a0000000000000000000000000000003", "Title": "Agriculture and assets", "VariableName": "",
      "IsRoster": false, "ConditionExpression": "consent == 1",
      "Children": [
        { "$type": "SingleQuestion", "PublicKey": "d0000000000000000000000000000001", "QuestionType": 0,
          "VariableName": "has_crops", "QuestionText": "Did the household grow crops?",
          "Answers": [ {"AnswerText": "Yes", "AnswerValue": "1"}, {"AnswerText": "No", "AnswerValue": "2"} ] },
        { "$type": "MultyOptionsQuestion", "PublicKey": "d0000000000000000000000000000002", "QuestionType": 3,
          "VariableName": "crops", "QuestionText": "Which crops?", "ConditionExpression": "has_crops == 1",
          "MaxAllowedAnswers": 3,
          "Answers": [ {"AnswerText": "Maize", "AnswerValue": "1"}, {"AnswerText": "Beans", "AnswerValue": "2"},
                       {"AnswerText": "Cassava", "AnswerValue": "3"}, {"AnswerText": "Rice", "AnswerValue": "4"} ] },
        { "$type": "Group", "PublicKey": "d0000000000000000000000000000003", "Title": "Crop details", "VariableName": "crop_r",
          "IsRoster": true, "RosterSizeSource": 0, "RosterSizeQuestionId": "d0000000000000000000000000000002",
          "Children": [
            { "$type": "NumericQuestion", "PublicKey": "d1000000000000000000000000000001", "QuestionType": 4,
              "VariableName": "crop_area", "QuestionText": "Area planted (ha)", "CountOfDecimalPlaces": 2,
              "ValidationConditions": [ {"Expression": "self > 0 && self <= 20", "Message": "0-20 ha", "Severity": 0} ] },
            { "$type": "NumericQuestion", "PublicKey": "d1000000000000000000000000000002", "QuestionType": 4,
              "VariableName": "harvest_kg", "QuestionText": "Harvest (kg)", "IsInteger": true,
              "ConditionExpression": "crop_area > 1.5" },
            { "$type": "SingleQuestion", "PublicKey": "d1000000000000000000000000000003", "QuestionType": 0,
              "VariableName": "sold", "QuestionText": "Any sold?", "ConditionExpression": "harvest_kg > 500",
              "Answers": [ {"AnswerText": "Yes", "AnswerValue": "1"}, {"AnswerText": "No", "AnswerValue": "2"} ] }
          ] },
        { "$type": "MultyOptionsQuestion", "PublicKey": "d0000000000000000000000000000004", "QuestionType": 3,
          "VariableName": "assets", "QuestionText": "Does the household own...", "YesNoView": true,
          "Answers": [ {"AnswerText": "Radio", "AnswerValue": "1"}, {"AnswerText": "TV", "AnswerValue": "2"},
                       {"AnswerText": "Bicycle", "AnswerValue": "3"}, {"AnswerText": "Mobile phone", "AnswerValue": "4"} ] },
        { "$type": "TextQuestion", "PublicKey": "d0000000000000000000000000000005", "QuestionType": 7,
          "VariableName": "phone", "QuestionText": "Phone number", "Mask": "07########",
          "ConditionExpression": "assets.Yes.Contains(4)" },
        { "$type": "TextListQuestion", "PublicKey": "d0000000000000000000000000000006", "QuestionType": 9,
          "VariableName": "kids", "QuestionText": "Names of children under 5", "MaxAnswerCount": 6,
          "ConditionExpression": "members.Any(x => x.age < 5)" },
        { "$type": "Group", "PublicKey": "d0000000000000000000000000000007", "Title": "Child health", "VariableName": "kid_r",
          "IsRoster": true, "RosterSizeSource": 0, "RosterSizeQuestionId": "d0000000000000000000000000000006",
          "Children": [
            { "$type": "SingleQuestion", "PublicKey": "d2000000000000000000000000000001", "QuestionType": 0,
              "VariableName": "vaccinated", "QuestionText": "Vaccination card seen?",
              "Answers": [ {"AnswerText": "Yes", "AnswerValue": "1"}, {"AnswerText": "No", "AnswerValue": "2"} ] }
          ] },
        { "$type": "Group", "PublicKey": "d0000000000000000000000000000008", "Title": "Livestock", "VariableName": "livestock",
          "IsRoster": true, "RosterSizeSource": 1,
          "FixedRosterTitles": [ {"Value": 1, "Title": "Cattle"}, {"Value": 2, "Title": "Goats"}, {"Value": 3, "Title": "Chickens"} ],
          "Children": [
            { "$type": "SingleQuestion", "PublicKey": "d3000000000000000000000000000001", "QuestionType": 0,
              "VariableName": "owns", "QuestionText": "Owns any?",
              "Answers": [ {"AnswerText": "Yes", "AnswerValue": "1"}, {"AnswerText": "No", "AnswerValue": "2"} ] },
            { "$type": "NumericQuestion", "PublicKey": "d3000000000000000000000000000002", "QuestionType": 4,
              "VariableName": "n_animals", "QuestionText": "How many?", "IsInteger": true,
              "ConditionExpression": "owns == 1",
              "ValidationConditions": [ {"Expression": "self.InRange(1, 300)", "Message": "1-300", "Severity": 0} ] }
          ] },
        { "$type": "DateTimeQuestion", "PublicKey": "d0000000000000000000000000000009", "QuestionType": 5,
          "VariableName": "last_visit", "QuestionText": "Date of last extension visit",
          "ConditionExpression": "has_crops == 1" },
        { "$type": "TextQuestion", "PublicKey": "d000000000000000000000000000000a", "QuestionType": 7,
          "VariableName": "sup_note", "QuestionText": "Supervisor note", "QuestionScope": 1 },
        { "$type": "StaticText", "PublicKey": "d000000000000000000000000000000b", "Text": "Thank the respondent." }
      ]
    }
  ]
}
